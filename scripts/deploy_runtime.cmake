cmake_minimum_required(VERSION 3.21)
foreach(_key IN ITEMS UI_EXECUTABLE OUTPUT_DIRECTORY VCPKG_BIN_DIRECTORY PYTHON_DIRECTORY CUDA_DIRECTORY DUMPBIN_EXE)
    if(NOT DEFINED ${_key} OR "${${_key}}" STREQUAL "")
        message(FATAL_ERROR "Missing runtime deployment argument: ${_key}")
    endif()
    file(TO_CMAKE_PATH "${${_key}}" ${_key})
endforeach()
get_filename_component(OUTPUT_DIRECTORY "${OUTPUT_DIRECTORY}" ABSOLUTE)
if(NOT EXISTS "${UI_EXECUTABLE}" OR NOT EXISTS "${DUMPBIN_EXE}")
    message(FATAL_ERROR "UI.exe or dumpbin.exe is missing")
endif()
file(MAKE_DIRECTORY "${OUTPUT_DIRECTORY}")
foreach(_python_dll IN ITEMS python3.dll python310.dll)
    if(NOT EXISTS "${PYTHON_DIRECTORY}/${_python_dll}")
        message(FATAL_ERROR "Missing Python runtime: ${PYTHON_DIRECTORY}/${_python_dll}")
    endif()
    file(COPY_FILE "${PYTHON_DIRECTORY}/${_python_dll}" "${OUTPUT_DIRECTORY}/${_python_dll}" ONLY_IF_DIFFERENT)
endforeach()
# Copy redistributable MSVC/OpenMP files from Visual Studio, never system/driver DLLs.
get_filename_component(_tool_dir "${DUMPBIN_EXE}" DIRECTORY)
get_filename_component(_vc_root "${_tool_dir}/../../../../../.." ABSOLUTE)
file(GLOB _redist_dirs "${_vc_root}/Redist/MSVC/*/x64/Microsoft.VC143.CRT" "${_vc_root}/Redist/MSVC/*/x64/Microsoft.VC143.OpenMP")
list(SORT _redist_dirs COMPARE NATURAL ORDER DESCENDING)
foreach(_dir IN LISTS _redist_dirs)
    file(GLOB _runtime_files "${_dir}/*.dll")
    foreach(_file IN LISTS _runtime_files)
        get_filename_component(_name "${_file}" NAME)
        if(NOT EXISTS "${OUTPUT_DIRECTORY}/${_name}")
            file(COPY_FILE "${_file}" "${OUTPUT_DIRECTORY}/${_name}" ONLY_IF_DIFFERENT)
        endif()
    endforeach()
endforeach()
set(CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM windows+pe)
set(CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL dumpbin)
set(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND "${DUMPBIN_EXE}")
set(_search_dirs "${OUTPUT_DIRECTORY}" "${VCPKG_BIN_DIRECTORY}" "${PYTHON_DIRECTORY}" "${PYTHON_DIRECTORY}/DLLs" "${CUDA_DIRECTORY}/bin")
file(GLOB_RECURSE _plugins "${OUTPUT_DIRECTORY}/platforms/*.dll" "${OUTPUT_DIRECTORY}/imageformats/*.dll" "${OUTPUT_DIRECTORY}/styles/*.dll" "${OUTPUT_DIRECTORY}/iconengines/*.dll")
file(GLOB _local_dlls "${OUTPUT_DIRECTORY}/*.dll")
file(GET_RUNTIME_DEPENDENCIES
    EXECUTABLES "${UI_EXECUTABLE}"
    LIBRARIES ${_local_dlls}
    MODULES ${_plugins}
    DIRECTORIES ${_search_dirs}
    RESOLVED_DEPENDENCIES_VAR _resolved
    UNRESOLVED_DEPENDENCIES_VAR _unresolved
    PRE_EXCLUDE_REGEXES "api-ms-.*" "ext-ms-.*"
    POST_EXCLUDE_REGEXES ".*[/\\\\][Ww][Ii][Nn][Dd][Oo][Ww][Ss][/\\\\][Ss][Yy][Ss][Tt][Ee][Mm]32[/\\\\].*")
if(_unresolved)
    list(JOIN _unresolved ", " _missing)
    message(FATAL_ERROR "Unresolved runtime DLLs: ${_missing}")
endif()
set(_manifest "Runtime dependency sources (Windows system/driver DLLs excluded):\n")
foreach(_file IN LISTS _resolved)
    get_filename_component(_name "${_file}" NAME)
    get_filename_component(_parent "${_file}" DIRECTORY)
    if(NOT _parent STREQUAL OUTPUT_DIRECTORY)
        file(COPY_FILE "${_file}" "${OUTPUT_DIRECTORY}/${_name}" ONLY_IF_DIFFERENT)
    endif()
    string(APPEND _manifest "${_name}\t${_file}\n")
endforeach()
file(WRITE "${OUTPUT_DIRECTORY}/runtime-dependencies.txt" "${_manifest}")
list(LENGTH _resolved _count)
message(STATUS "Deployed ${_count} resolved runtime dependencies to ${OUTPUT_DIRECTORY}")

# Seed the existing executable-relative configuration once; preserve user edits thereafter.
if(DEFINED SETTINGS_SOURCE AND EXISTS "${SETTINGS_SOURCE}")
    get_filename_component(_settings_dir "${OUTPUT_DIRECTORY}/.." ABSOLUTE)
    set(_settings_path "${_settings_dir}/settings.ini")
    if(NOT EXISTS "${_settings_path}")
        file(READ "${SETTINGS_SOURCE}" _settings)
        get_filename_component(_repo_dir "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
        string(REGEX REPLACE "PythonHome=[^\r\n]*" "PythonHome=${PYTHON_DIRECTORY}" _settings "${_settings}")
        string(REGEX REPLACE "PythonWorkspace=[^\r\n]*" "PythonWorkspace=${_repo_dir}/scripts/pyscripts" _settings "${_settings}")
        file(WRITE "${_settings_path}" "${_settings}")
    endif()
endif()
