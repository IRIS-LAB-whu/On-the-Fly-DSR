    <Open3DBuildCommand>powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(Open3DBuildScript)&quot; -CudaRoot &quot;$(CudaToolkitDir)\.&quot; -CudaArchitectures &quot;$(Open3DCudaArchitectures)&quot; -BuildDirectory &quot;$(Open3DBuildDirectory)\.&quot; -InstallDirectory &quot;$(Open3DWeightedRoot)\.&quot; -CMakeExecutable &quot;$(Open3DCMakeExecutable)&quot;</Open3DBuildCommand>
