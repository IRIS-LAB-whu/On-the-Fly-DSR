    <NMakeBuildCommandLine>$(Open3DBuildCommand)</NMakeBuildCommandLine>
    <NMakeReBuildCommandLine>$(Open3DBuildCommand) -Rebuild</NMakeReBuildCommandLine>
    <NMakeCleanCommandLine>$(Open3DBuildCommand) -Clean</NMakeCleanCommandLine>
    <!-- Intentionally absent: VS must always let CMake check changed library sources. -->
    <NMakeOutput>$(Open3DBuildDirectory)\Open3DWeightedTSDF.always</NMakeOutput>
    <NMakeIncludeSearchPath>$(MSBuildProjectDirectory)\source\cpp;$(Open3DWeightedRoot)\include;$(Open3DWeightedRoot)\include\open3d\3rdparty;$(CudaToolkitDir)\include;$(NMakeIncludeSearchPath)</NMakeIncludeSearchPath>
